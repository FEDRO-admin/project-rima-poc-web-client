@startuml
!theme plain
skinparam backgroundColor #FAFAFA
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 10
skinparam boxPadding 8
skinparam sequenceGroupBorderThickness 2
skinparam noteBorderColor #888888
skinparam noteBackgroundColor #FFFFDD
skinparam ParticipantBorderThickness 1.5
skinparam ArrowColor #444444
skinparam defaultFontSize 11
skinparam SequenceMessageAlignment left

title RIMA PoC - Table of Contents (ToC) Flow\nTask 579 / August 2026

actor "User" as user #LightBlue
participant "MapComponent\ntemplate" as mapTpl #E8F5E9
participant "TocComponent" as tocComp #F3E5F5
participant "HistoryPickerComponent" as histPicker #F3E5F5
participant "arcgis-layer-list\n[Web Component]" as layerList #FFEBEE
participant "ViewService\n[Signal]" as viewSvc #E8F5E9
participant "HistoryStore\n[SignalStore]" as histStore #E3F2FD
participant "CreateStore\n[SignalStore]" as createStore #E3F2FD
participant "ArcGIS View\n(MapView/SceneView)" as view #FFEBEE
participant "ArcGIS Layer" as layer #FFEBEE

== Component Initialisation ==

mapTpl -> tocComp : Angular renders <rima-toc>\nin MapComponent template
activate tocComp

note over tocComp
  TocComponent constructor:
  - injects ViewService, CreateStore, HistoryStore
  - resolves viewChild('layerList')
    -> reference to <arcgis-layer-list> element
  - registers Angular effect() watching
    viewService.activeView() signal
end note

tocComp -> layerList : Template renders:\n<arcgis-layer-list\n  #layerList\n  heading-level="2"\n  show-heading\n  show-errors\n  show-filter\n  min-filter-items="1"\n  selection-mode="single"\n  visibility-appearance="checkbox"\n  (arcgisTriggerAction)="onTriggerAction($event)"\n>
activate layerList

tocComp -> histPicker : renders <rima-history-picker>\nin toc-footer
activate histPicker

note over layerList
  At this point the layer list is empty.
  It requires a view reference before
  it can display any layers.
end note

== Reactive Binding (triggered by view registration) ==

viewSvc -> viewSvc : writableActiveView.set(view)\n[signal emits from ViewService.setInitialView()]

note over tocComp
  Angular effect() fires because
  viewService.activeView() signal changed.
  Inside untracked():
  - assigns view to layer list
  - sets listItemCreatedFunction callback
end note

tocComp -> layerList : layerList.view = activeView
tocComp -> layerList : layerList.listItemCreatedFunction =\n  onListItemCreated callback

layerList -> view : reads map.layers collection
layerList -> layerList : builds list items from\nmap layer hierarchy\n(GroupLayer -> nested items,\n FeatureLayer/MapImageLayer/WMTSLayer -> leaf items)

== List Item Creation (per layer) ==

group For each layer in the map
  layerList -> tocComp : listItemCreatedFunction({ item })
  activate tocComp

  alt item.layer instanceof FeatureLayer
    tocComp -> layerList : item.actionsSections = [\n  [{ title:'Zoom to',\n     icon:'zoom-to-object',\n     id:'zoom-to-layer' }],\n  [{ title:'Create',\n     icon:'plus',\n     id:'create-feature' }]\n]
    note right of layerList
      FeatureLayer entries get both
      "Zoom to" AND "Create" actions.
    end note
  else item.layer instanceof MapImageLayer
    tocComp -> layerList : item.actionsSections = [\n  [{ title:'Zoom to',\n     icon:'zoom-to-object',\n     id:'zoom-to-layer' }]\n]
    note right of layerList
      MapImageLayer entries get
      only "Zoom to" action.
    end note
  else other layer types (GroupLayer, WMSLayer, WMTSLayer, etc.)
    tocComp -> layerList : no action added
  end

  deactivate tocComp
end group

note over layerList
  Layer list is now fully populated.
  User sees:
  - Hierarchical layer tree (GroupLayers as folders)
  - Checkboxes to toggle layer visibility
  - Filter/search input
  - "Zoom to" buttons on Feature/MapImage layers
  - "Create" buttons on Feature layers
  - History picker in footer
end note

== User Interaction: Toggle Visibility ==

user -> layerList : clicks checkbox on a layer
layerList -> view : layer.visible = true/false
note over view : ArcGIS SDK immediately\nshows/hides the layer on the map

== User Interaction: Zoom to Layer ==

user -> layerList : clicks "Zoom to" action button
layerList -> tocComp : (arcgisTriggerAction) event\n{ action: { id:'zoom-to-layer' },\n  item: { layer } }
activate tocComp

tocComp -> tocComp : onTriggerAction(event)\ncheck: action.id === 'zoom-to-layer'
tocComp -> viewSvc : read activeView() signal
viewSvc --> tocComp : MapView or SceneView reference

tocComp -> layer : [ASYNC] layer.load()
activate layer
note right of layer
  Ensures layer metadata
  (including fullExtent)
  is fully loaded from server.
end note
layer --> tocComp : layer loaded
deactivate layer

alt layer.fullExtent exists (FeatureLayer / MapImageLayer)
  tocComp -> view : [ASYNC] view.goTo(layer.fullExtent)
else layer.type === 'wmts' (fallback)
  tocComp -> view : [ASYNC] view.goTo(\n  layer.activeLayer.fullExtent)
else no extent available
  tocComp -> tocComp : no navigation (silent)
end

deactivate tocComp

note over user
  Map animates to the selected
  layer's spatial extent.
end note

== User Interaction: Create Feature ==

user -> layerList : clicks "Create" action button\non a FeatureLayer
layerList -> tocComp : (arcgisTriggerAction) event\n{ action: { id:'create-feature' },\n  item: { layer } }
activate tocComp

tocComp -> tocComp : onTriggerAction(event)\ncheck: action.id === 'create-feature'

tocComp -> histStore : check historyStore.active()
alt history mode is active
  tocComp -> tocComp : return (creation blocked)
else history mode is inactive
  tocComp -> layer : [ASYNC] layer.load()
  activate layer
  layer --> tocComp : layer loaded
  deactivate layer

  tocComp -> createStore : activate(layer)
  note over createStore
    CreateStore.activate() sets:
    - active = true
    - layer reference
    
    This triggers CreateEffects:
    - closes any open popup
    - cancels active edits
  end note
end

deactivate tocComp

note over user
  Create form panel opens.
  User can fill in feature attributes
  and place the feature on the map.
end note

@enduml
