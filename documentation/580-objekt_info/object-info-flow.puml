@startuml
!theme plain
skinparam backgroundColor #FAFAFA
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 10
skinparam boxPadding 8
skinparam sequenceGroupBorderThickness 2
skinparam noteBorderColor #888888
skinparam noteBackgroundColor #FFFFDD
skinparam ParticipantBorderThickness 1.5
skinparam ArrowColor #444444
skinparam defaultFontSize 11
skinparam SequenceMessageAlignment left

title RIMA PoC - Object Info (Popup) Flow\nTask 580 / July 2026

actor "User" as user #LightBlue
participant "ArcGIS MapView" as mapView #FFEBEE
participant "PopupEffects" as popupEffects #F3E5F5
participant "PopupService" as popupSvc #F3E5F5
participant "EditEffects\nCreateEffects\nDeleteEffects" as sessionGuards #F3E5F5
participant "PopupStore\n[SignalStore]" as store #F3E5F5
participant "DeleteService\n+DeleteStore" as deleteSvc #F3E5F5
participant "EditService" as editSvc #F3E5F5
participant "PopupComponent" as popupComp #E8F5E9
participant "PopupContentComponent" as contentComp #E8F5E9
participant "AttributesTabComponent" as attrTab #E8F5E9
participant "HierarchyTabComponent\n+HierarchyStore\n+HierarchyEffects\n+HierarchyService" as hierarchyTab #E8F5E9
participant "FeatureLayerView" as layerView #FFEBEE

== Initialisation ==

note over popupEffects
  PopupEffects constructor registers
  4 reactive effects:
  1. attachClickHandler() — watch mapView()
  2. highlightSelected() — watch selectedGraphic()
  3. highlightHovered() — watch hoveredIndex()
  4. clearHighlight() — watch visible()
end note

popupEffects -> popupSvc : effect(): mapView() available\n-> attach(view)
popupSvc -> mapView : view.popupEnabled = false\n(disables native SDK popup)
popupSvc -> mapView : view.on('click', handleClick)

== User Clicks on Map ==

user -> mapView : clicks on map
mapView -> popupSvc : click event { x, y }
activate popupSvc

popupSvc -> sessionGuards : editing() || creating() || deleting()
alt any session guard is active
  note over popupSvc
    Click IGNORED — edit, create, or
    delete session is active.
  end note
else no active session
  popupSvc -> mapView : [ASYNC] view.hitTest(event,\n  { include: all FeatureLayers })
  activate mapView
  mapView --> popupSvc : HitTestResult { results[] }
  deactivate mapView

  popupSvc -> popupSvc : Extract Graphic[] from results\n(filter type === 'graphic')

  alt graphics.length > 0
    popupSvc -> store : open(graphics)
    activate store

    alt graphics.length === 1
      store -> store : patchState({\n  graphics,\n  selectedIndex: 0,\n  visible: true\n})\n-> jumps directly to detail view
    else graphics.length > 1
      store -> store : patchState({\n  graphics,\n  selectedIndex: undefined,\n  visible: true\n})\n-> shows feature list view
    end

    deactivate store
  else no graphics hit
    popupSvc -> store : close()
    store -> store : reset all state
  end
end

deactivate popupSvc

== Highlight Reacts to Store ==

note over popupEffects
  effect() fires: selectedGraphic() changed
end note

popupEffects -> popupSvc : clearSelectionHighlight()
popupEffects -> popupSvc : highlightGraphic(graphic, 'selection')
popupSvc -> mapView : [ASYNC] view.whenLayerView(graphic.layer)
mapView --> popupSvc : FeatureLayerView
popupSvc -> layerView : layerView.highlight(graphic)
activate layerView
note right of layerView
  Blue outline/fill rendered
  around the selected feature
  on the map.
end note
deactivate layerView

== UI Renders ==

alt store.showList() (multiple features)

  popupComp -> popupComp : Render popup card with:\n- Header: [close button]\n- Title: "Features (N)"\n- Scrollable list of feature buttons

  user -> popupComp : hovers over list item [index]
  popupComp -> store : hoverFeature(index)

  note over popupEffects
    effect() fires: hoveredIndex() changed
  end note
  popupEffects -> popupSvc : clearHoverHighlight()
  popupEffects -> popupSvc : highlightGraphic(graphic, 'hover')

  user -> popupComp : clicks list item [index]
  popupComp -> store : selectFeature(index)
  store -> store : patchState({ selectedIndex: index,\n  hoveredIndex: undefined })

  note over popupEffects
    effect() fires: selectedGraphic() changed
    -> update selection highlight
  end note

else store.showDetail() (single feature)

  popupComp -> popupComp : Render popup card with:\n- Header: [back?] [zoom-to] [edit?] [delete?] [close]\n- <rima-popup-content>
  popupComp -> contentComp : [graphic] = selectedGraphic
  activate contentComp

  contentComp -> contentComp : Compute title from graphic.layer.title

  note over contentComp
    Tabbed view:
    [Attributes] [Hierarchy] [Documents]
    Default: Attributes tab active.
  end note

  contentComp -> attrTab : [graphic] = graphic
  note over attrTab
    Read-only mode:
    - Key-value table using field.alias as label
    - Coded-value domains resolved to names
    - Non-immutable fields in main table
    - Immutable (system) fields in
      collapsible <details> "Immutable"
  end note

  contentComp -> hierarchyTab : [graphic] = graphic
  note over hierarchyTab
    On graphic input change:
    -> HierarchyStore.setGraphic(graphic)
    -> HierarchyEffects fires
    -> HierarchyService.buildHierarchyTree()

    Tree structure:
    - Parent chain (role=destination, upward)
    - Selected feature node (isClickedFeature=true)
    - Children recursive (role=origin, grouped
      by related layer title)

    Renders <calcite-tree> with load/error states.

    On node click:
    -> Flash feature on map (3 blinks, 150ms)
    -> Persist highlight until next click or destroy
  end note

  deactivate contentComp
end

== User Actions in Detail View ==

user -> popupComp : clicks "Zoom to"
popupComp -> popupComp : zoomTo()\nread selectedGraphic().geometry
popupComp -> mapView : [ASYNC] view.goTo(\n  { target: geometry, zoom: 15 })

user -> popupComp : clicks "Back" (chevron)
popupComp -> store : backToList()
store -> store : patchState({ selectedIndex: undefined })
note over popupEffects : selection highlight cleared\n(no selectedGraphic)
note over popupComp : UI returns to feature list view

user -> popupComp : clicks "Edit" (pencil icon)\n[only if isLayerEditable()]
popupComp -> editSvc : activate(graphic)
editSvc -> store : close()
note over editSvc : Popup closes;\nedit workflow begins\n(see 583-editing)

user -> popupComp : clicks "Delete" (trash icon)\n[only if isLayerDeletable()]
popupComp -> deleteSvc : requestDelete(graphic)
deleteSvc -> deleteSvc : deleteStore.requestDelete()\n-> confirmRequested = true
note over popupComp : <rima-confirm-dialog> appears\ninside the popup card

alt user confirms delete
  popupComp -> deleteSvc : confirmDelete()
  deleteSvc -> mapView : [ASYNC] layer.applyEdits(\n  { deleteFeatures: [graphic] })
  mapView --> deleteSvc : EditResults
  deleteSvc -> store : close()
  note over deleteSvc : layer.refresh();\npopup closes
else user cancels delete
  popupComp -> deleteSvc : cancelDelete()
  note over popupComp : Popup stays open; delete aborted
end

== Close Popup ==

alt user clicks close button
  user -> popupComp : clicks ✕
  popupComp -> popupComp : requestClose()
  popupComp -> store : close()
else user presses Escape
  user -> popupComp : onEscape()
  popupComp -> popupComp : requestClose()
  popupComp -> store : close()
else user clicks empty map area
  user -> mapView : click (no features hit)
  popupSvc -> store : close()
end

store -> store : patchState({\n  graphics: [],\n  selectedIndex: undefined,\n  hoveredIndex: undefined,\n  visible: false\n})

note over popupEffects : effect() fires:\nvisible() = false\n-> clearAllHighlights()

note over popupComp : @if (store.visible()) hides\nthe entire popup card

@enduml
