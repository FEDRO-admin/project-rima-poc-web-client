@startuml
!theme plain
skinparam backgroundColor #FAFAFA
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 10
skinparam boxPadding 8
skinparam sequenceGroupBorderThickness 2
skinparam noteBorderColor #888888
skinparam noteBackgroundColor #FFFFDD
skinparam ParticipantBorderThickness 1.5
skinparam ArrowColor #444444
skinparam defaultFontSize 11
skinparam SequenceMessageAlignment left

title RIMA PoC - Historical Data Viewer Flow\nTask 584 / July 2026

actor "User" as user #LightBlue
participant "HistoryPickerComponent\n(TOC footer)" as picker #E8F5E9
participant "HistoricMomentsService" as momentsSvc #F3E5F5
participant "HistoryStore\n[SignalStore]" as store #F3E5F5
participant "HistoryEffects" as effects #F3E5F5
participant "HistoryService" as historySvc #F3E5F5
participant "PopupStore" as popupStore #F3E5F5
participant "EditService" as editSvc #F3E5F5
participant "CreateStore" as createStore #F3E5F5
participant "FeatureLayer[]\n(all in map)" as layers #FFEBEE
participant "RIMA SOE\n(ArcGIS Server)" as soe #FFEBEE

== Initialisation ==

note over effects
  HistoryEffects constructor registers 4 effects:
  1. closePopupOnActivate() — watch active()
  2. cancelEditsOnActivate() — watch active()
  3. cancelCreateOnActivate() — watch active()
  4. clearHistoricMomentOnDeactivate() — watch active()
end note

== User Opens Panel (lazy load) ==

user -> picker : clicks "Historical Moments" button
picker -> momentsSvc : [ASYNC] getHistoricMoments()
activate momentsSvc
momentsSvc -> soe : [ASYNC] esriRequest(getHistoricMoments,\n  { query: { f: 'json' } })
activate soe
soe --> momentsSvc : JSON { name: dateString, ... }
deactivate soe
momentsSvc -> momentsSvc : filter out 'DEFAULT'\nmap to HistoricMomentEntry[]
momentsSvc --> picker : HistoricMomentEntry[]
deactivate momentsSvc
picker -> picker : cdr.detectChanges()\nrender list items:\n"name (dd.MM.yyyy HH:mm)" per entry

== User Selects a Named Moment ==

user -> picker : clicks a named moment entry
picker -> picker : selectMoment(entry)\nparse Date from entry.date
picker -> store : activate(date)
activate store
store -> store : patchState({ active: true,\n  selectedDate: date })
deactivate store

picker -> historySvc : applyHistoricMoment(date)
activate historySvc
historySvc -> layers : forEach FeatureLayer:\n  layer.historicMoment = date\n  layer.refresh()
note over layers
  All feature layers now display
  data as it existed at the selected timestamp.
  ArcGIS SDK queries the versioned data store.
end note
deactivate historySvc

note over effects
  effect() fires: active() = true
end note

effects -> popupStore : close()\n(dismiss any open popup)
alt edit session active
  effects -> editSvc : reset()\n(cancel edit)
end
alt create session active
  effects -> createStore : reset()\n(cancel create)
end

picker -> picker : Show "Return to Present" button\n+ "Viewing: dd.MM.yyyy HH:mm"

== User Adds a Marker ==

user -> picker : clicks "Add Marker"
picker -> picker : show add form\n(name, date, time inputs)
user -> picker : fills name, date, time\nclicks "Save"
picker -> picker : submitAdd()\nbuild ISO timestamp
picker -> momentsSvc : [ASYNC] addHistoricMoment(name, timestamp)
activate momentsSvc
momentsSvc -> soe : [ASYNC] esriRequest(addHistoricMoment,\n  { query: { f: 'json', name, timestamp } })
activate soe
alt success
  soe --> momentsSvc : { status: 'success' }
  momentsSvc --> picker : { success: true }
  picker -> momentsSvc : [ASYNC] getHistoricMoments()
  momentsSvc -> soe : esriRequest(getHistoricMoments)
  soe --> momentsSvc : updated list
  momentsSvc --> picker : HistoricMomentEntry[]
  picker -> picker : refresh list + cdr.detectChanges()
else error
  soe --> momentsSvc : { status: 'error', message: '...' }
  momentsSvc --> picker : { success: false, message: '...' }
  picker -> picker : show calcite-notice (danger)\nwith error message
end
deactivate soe
deactivate momentsSvc

== User Deletes a Marker ==

user -> picker : clicks trash icon on a marker
picker -> picker : confirmDelete(entry)\nshow confirmation prompt
user -> picker : clicks "Delete"
picker -> momentsSvc : [ASYNC] deleteHistoricMoment(name)
activate momentsSvc
momentsSvc -> soe : [ASYNC] esriRequest(delHistoricMoment,\n  { query: { f: 'json', name } })
activate soe
alt success
  soe --> momentsSvc : { status: 'success' }
  momentsSvc --> picker : { success: true }
  picker -> momentsSvc : [ASYNC] getHistoricMoments()
  momentsSvc -> soe : esriRequest(getHistoricMoments)
  soe --> momentsSvc : updated list
  momentsSvc --> picker : HistoricMomentEntry[]
  picker -> picker : refresh list + cdr.detectChanges()
else error
  soe --> momentsSvc : { status: 'error', message: '...' }
  momentsSvc --> picker : { success: false, message: '...' }
  picker -> picker : show calcite-notice (danger)\nwith error message
end
deactivate soe
deactivate momentsSvc

== User Selects Custom Date/Time ==

user -> picker : expands "Custom Date & Time"
user -> picker : picks date via calcite-input-date-picker
user -> picker : picks time via calcite-input-time-picker
user -> picker : clicks "Apply"
picker -> picker : applyCustomDate()\ncombine date + time -> Date
picker -> store : activate(date)
picker -> historySvc : applyHistoricMoment(date)
activate historySvc
historySvc -> layers : forEach FeatureLayer:\n  layer.historicMoment = date\n  layer.refresh()
deactivate historySvc

== User Returns to Present ==

user -> picker : clicks "Return to Present"
picker -> store : deactivate()
activate store
store -> store : patchState({ active: false,\n  selectedDate: null })
deactivate store

note over effects
  effect() fires: active() = false
  -> clearHistoricMomentOnDeactivate()
end note

effects -> historySvc : clearHistoricMoment()
activate historySvc
historySvc -> layers : forEach FeatureLayer:\n  layer.historicMoment = null\n  layer.refresh()
note over layers
  All feature layers now display
  live (current) data again.
end note
deactivate historySvc

picker -> picker : Hide "Return to Present" button\nShow normal panel state

@enduml
