@startuml
!theme plain
skinparam backgroundColor #FAFAFA
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 10
skinparam boxPadding 8
skinparam sequenceGroupBorderThickness 2
skinparam noteBorderColor #888888
skinparam noteBackgroundColor #FFFFDD
skinparam ParticipantBorderThickness 1.5
skinparam ArrowColor #444444
skinparam defaultFontSize 11
skinparam SequenceMessageAlignment left

title RIMA PoC - Content Catalog Build Flow\nTask 644 / August 2026

participant "MapComponent" as mapComp #E8F5E9
participant "MapViewInitService" as initSvc #F3E5F5
participant "LanguageStore\n[SignalStore]" as langStore #FFF8E7
participant "language-info-config" as langConfig #FFF8E7
participant "PortalService" as portalSvc #F3E5F5
participant "ArcGIS Portal" as portal #FFEBEE
participant "LayerService" as layerSvc #E8F5E9
participant "ArcGIS MapView" as mapView #FFEBEE

== Application Startup ==

mapComp -> initSvc : [ASYNC] init(mapElement)
activate initSvc

initSvc -> initSvc : registerMapView(view)\naddBasemap()
initSvc -> mapView : [ASYNC] view.when()
activate mapView
mapView --> initSvc : MapView ready
deactivate mapView

== Step 1 — Resolve Language Category ==

initSvc -> langStore : read activeLanguage()\n-> e.g. 'de'
initSvc -> langConfig : lookup catalogId for 'de'\n-> 'FC'

note over langConfig
  Language-to-Portal category mapping:
  de -> 'FC'
  fr -> 'FR'
  it -> 'IT'
  Source: src/i18n/language-info-config.ts
end note

alt no mapping found
  initSvc -> initSvc : throw MapViewLanguageCategoryMissingError\n(FatalError -> redirect to error page)
end

== Step 2 — Query Portal for Web Map Items ==

initSvc -> portalSvc : [ASYNC] queryItems(\n  categories: ['/Categories/FC'],\n  query: 'type:"Web Map"',\n  num: 100,\n  sortField: 'title', sortOrder: 'asc')
activate portalSvc
portalSvc -> portal : [ASYNC] Portal.load()\n  url: RIMA_PORTAL_URL\n  authMode: 'immediate'
activate portal
portal --> portalSvc : Portal (cached after first load)
deactivate portal
portalSvc -> portal : [ASYNC] portal.queryItems()
activate portal
portal --> portalSvc : PortalItem[]
deactivate portal
portalSvc --> initSvc : PortalItem[]
deactivate portalSvc

== Step 3 — Fetch and Parse Each Web Map (parallel) ==

note over initSvc
  Promise.all() — processes all items in parallel
end note

group Parallel: for each PortalItem
  initSvc -> portal : [ASYNC] item.fetchData('json')
  activate portal
  portal --> initSvc : WebmapDataJson
  deactivate portal

  initSvc -> layerSvc : parseWebmapJsonToLayers(data)
  activate layerSvc

  note over layerSvc
    Walks operationalLayers[] array.
    For each entry, dispatches on layerType:

    ArcGISFeatureLayer -> FeatureLayer
      (outFields: ['*'], fullExtent: Switzerland)
    GroupLayer -> GroupLayer (recurse children)
    WMS -> WMSLayer
    WebTiledLayer -> WMTSLayer
      (uses wmtsInfo.url + layerIdentifier)

    Skips unknown types or missing URLs.
  end note

  layerSvc --> initSvc : Layer[]
  deactivate layerSvc

  alt RIMA_MAPVIEW_WRAP_WEBMAP_AS_GROUP = true
    initSvc -> initSvc : wrap layers in GroupLayer\n  title = item.title
  end

  alt item categories contain 'HIDDEN'
    initSvc -> initSvc : set visible = false\n  listMode = 'hide'
  end
end group

== Step 4 — Add Layers to Map ==

initSvc -> initSvc : flatten + reverse layer array\n(first item appears on top)
initSvc -> mapView : view.map.addMany(layers)

note over mapView
  Map layer collection is now populated.
  The arcgis-layer-list (ToC) reads this
  collection and renders the hierarchy
  automatically.
end note

deactivate initSvc

== View Registration ==

mapComp -> mapComp : viewService.setInitialView(mapView)\n-> activeView signal emits\n-> TocComponent effect binds\n   layer list to the view

@enduml
